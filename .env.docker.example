# ============================================================================
# Biến secret / toggle cho docker-compose.
#
#   cp .env.docker.example .env
#   docker compose up --build
#
# CHỈ các biến trong file này được đọc từ .env. Toàn bộ wiring nội bộ giữa
# các container (hostname, credential của datastore bundled như postgres/neo4j/
# redis/kafka...) đã được hard-code sẵn trong docker-compose.yml — nên một
# file .env kiểu "cloud" bị copy nhầm cũng không thể làm hỏng kết nối giữa
# các service.
# ============================================================================

# Spring profile của backend. "dev" = tự chạy seed data (tài khoản admin mẫu
# admin@techradar.vn / Admin@12345) + log chi tiết (DEBUG). Đặt "prod" khi lên
# production: không seed data mẫu, log chỉ ở mức WARN.
APP_ENV=dev

# Khoá bí mật dùng để ký JWT (access token đăng nhập). Ở production PHẢI đổi
# sang một chuỗi ngẫu nhiên, độ dài tối thiểu 256-bit (32 ký tự) — nếu để giá
# trị mặc định, ai đọc được source code cũng tự ký được token giả mạo.
JWT_SECRET=change-this-in-production-with-at-least-256-bits

# Secret dùng chung giữa gateway (Spring backend) và service ai-rag-core (Python),
# gửi qua header "X-Internal-Auth" để ai-rag-core biết request đến từ gateway
# nội bộ, không phải request lạ từ ngoài. BẮT BUỘC phải giống nhau ở cả hai vì
# docker-compose tự inject giá trị này vào cả spring-api và ai-rag-core.
INTERNAL_API_TOKEN=techradar-internal-secret

# Nhà cung cấp LLM dùng để trả lời chat (RAG). Nhận "openai", "gemini" hoặc "groq".
# Thiếu API key tương ứng thì cả hệ thống vẫn khởi động bình thường, nhưng các
# tính năng chat/hỏi-đáp sẽ trả lỗi khi được gọi tới.
#
# Cùng 3 key OPENAI_API_KEY/GEMINI_API_KEY/GROQ_API_KEY này cũng được data-platform
# tái sử dụng cho job `tech_dedup` (gộp Technology node trùng lặp, Giai đoạn B — LLM
# phát hiện case chưa có trong dp_tech_alias_map). Thiếu key thì Giai đoạn B tự
# skip, không lỗi — xem TECH_DEDUP_LLM_PROVIDER bên dưới.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Danh sách domain được phép gọi API (CORS) cho gateway (ALLOWED_ORIGINS) và
# cho service RAG (CORS_ORIGINS). "*" = cho phép tất cả, chỉ nên dùng khi dev.
# Ở production nên giới hạn thành domain frontend thật, ví dụ:
#   ALLOWED_ORIGINS=https://techradar.vn
#   CORS_ORIGINS=https://techradar.vn
ALLOWED_ORIGINS=*
CORS_ORIGINS=*

# Link chèn vào email "quên mật khẩu" (người dùng bấm mở link này rồi nhập mã
# reset). Ở production PHẢI đổi thành domain frontend thật, ví dụ:
#   WEB_RESET_URL=https://techradar.vn/login
WEB_RESET_URL=http://localhost:5173/login

# ── Mail / SMTP (gửi email reset mật khẩu) ──────────────────────────────────
# Mặc định các biến dưới đây trỏ vào MailHog — một SMTP giả lập chạy kèm trong
# docker-compose, CHỈ dùng để test ở dev. Email "gửi" đi sẽ không tới hộp mail
# thật của ai cả, mà hiển thị ở giao diện web MailHog: http://localhost:8025
#
# Để gửi được email THẬT tới người dùng ở production, đổi các giá trị MAIL_*
# bên dưới sang thông tin của một nhà cung cấp SMTP thật. Ví dụ:
#
#   1) Gmail SMTP (dễ dùng để test nhanh, giới hạn ~500 email/ngày):
#        MAIL_HOST=smtp.gmail.com
#        MAIL_PORT=587
#        MAIL_USER=<địa-chỉ-gmail-của-bạn>@gmail.com
#        MAIL_PASSWORD=<App Password 16 ký tự — KHÔNG dùng mật khẩu Gmail thường>
#        (Tạo App Password tại https://myaccount.google.com/apppasswords,
#         chỉ hiện ra khi tài khoản Google đã bật Xác minh 2 bước)
#        MAIL_SMTP_AUTH=true
#        MAIL_SMTP_STARTTLS=true
#
#   2) SendGrid / Mailgun / AWS SES (khuyến nghị cho production thật —
#      cần xác thực domain qua SPF/DKIM để email không bị rơi vào spam):
#        MAIL_HOST=smtp.sendgrid.net
#        MAIL_PORT=587
#        MAIL_USER=apikey                 # đúng literal là chữ "apikey", không phải username
#        MAIL_PASSWORD=<SendGrid API Key>
#        MAIL_SMTP_AUTH=true
#        MAIL_SMTP_STARTTLS=true
#
# Địa chỉ server SMTP. "mailhog" = container SMTP giả lập trong docker-compose (chỉ dùng cho dev).
MAIL_HOST=mailhog

# Cổng kết nối SMTP. 1025 = cổng của MailHog. 587 = cổng chuẩn STARTTLS (Gmail, SendGrid, SES...).
MAIL_PORT=1025

# Tài khoản đăng nhập SMTP (username hoặc "apikey" tùy provider). Để trống nếu server không cần auth (MailHog).
MAIL_USER=

# Mật khẩu / App Password / API Key đăng nhập SMTP. Để trống nếu server không cần auth (MailHog).
# ĐÂY LÀ SECRET THẬT — không commit giá trị thật vào git, chỉ set trong file .env cục bộ hoặc secret manager.
MAIL_PASSWORD=

# Có bật xác thực username/password khi kết nối SMTP không. MailHog: false. SMTP thật: luôn phải true.
MAIL_SMTP_AUTH=false

# Có bật mã hóa STARTTLS khi kết nối SMTP không. MailHog: false. SMTP thật (Gmail/SendGrid/SES...): luôn phải true.
MAIL_SMTP_STARTTLS=false

# Địa chỉ hiển thị ở mục "From" của email gửi đi. Nên dùng email thuộc domain đã xác thực
# SPF/DKIM (domain thật của công ty/dự án) để tránh bị các nhà cung cấp mail (Gmail, Outlook...) đánh spam.
MAIL_FROM=no-reply@techradar.vn

# ml-clustering (service Python phân cụm công nghệ): nơi lưu artifact tuỳ chọn
# trên MinIO (file snapshot .parquet + cluster_labels.json đã huấn luyện trước),
# dùng chung MinIO đã có sẵn trong docker-compose — không cần AWS S3.
# Để trống MLCLUSTER_MINIO_BUCKET thì service vẫn chạy được, chỉ là sẽ tự phân cụm
# trực tiếp từ dữ liệu Neo4j / dữ liệu seed sẵn có, thay vì load artifact có sẵn.
MLCLUSTER_MINIO_BUCKET=ml-clustering
# Thư mục con (prefix) bên trong bucket chứa các file artifact. Chỉ có ý nghĩa
# khi MLCLUSTER_MINIO_BUCKET đã được set ở trên.
MLCLUSTER_MINIO_PREFIX=ml-clustering
MLCLUSTER_MINIO_ACCESS_KEY=minioadmin
MLCLUSTER_MINIO_SECRET_KEY=minioadmin123

# Chế độ "làm nóng" mô hình AI (embedding/NER) của ai-rag-core lúc service khởi động:
#   blocking   = tải mô hình xong mới nhận request (khởi động chậm hơn nhưng request đầu tiên không bị lag)
#   background = nhận request ngay, tải mô hình song song ở nền (khởi động nhanh, vài request đầu có thể chậm)
#   none       = không tải trước, mô hình chỉ tải khi có request đầu tiên cần dùng
MODEL_WARMUP=background

# ── Data Platform ──────────────────────────────────────────────────────────
# Secret dùng để data-platform scheduler gọi được endpoint POST /embed/trigger
# của ai-rag-core (kích hoạt job embedding dữ liệu mới). Giá trị này BẮT BUỘC
# phải khớp với EMBED_SECRET trong file .env riêng của ai-rag-core, nếu không
# request sẽ bị từ chối. Mặc định "changeme" chỉ dùng cho dev.
EMBED_SECRET=changeme

# Chu kỳ (giờ) giữa các lần crawler tự động chạy lại để lấy dữ liệu mới.
# Chỉ áp dụng cho container chạy dưới profile "crawl" (docker compose --profile crawl up).
CRAWL_INTERVAL_HOURS=6

# true = data-platform chạy ngay tất cả job (đồng bộ Neo4j, rebuild tech_analytics,
# embed trigger, enricher, tech dedup, retrain clustering) khi container start,
# thay vì đợi tới lịch cron (02:00-05:30 sáng, 06:00 Chủ nhật). Bật khi seed dữ
# liệu lần đầu trên máy mới; để false khi chạy production lâu dài để tránh chạy
# lại mỗi lần restart.
RUN_JOBS_ON_START=false

# Nhà cung cấp LLM cho job `tech_dedup` (độc lập với LLM_PROVIDER dùng cho chat
# RAG ở trên) — nhận "gemini", "openai" hoặc "groq".
TECH_DEDUP_LLM_PROVIDER=gemini

# GitHub Personal Access Token cho crawler GitHub.py (không bắt buộc).
# Không có token: giới hạn 60 request/giờ tới GitHub API.
# Có token: giới hạn tăng lên 5000 request/giờ.
# Tạo token tại https://github.com/settings/tokens — chỉ cần scope "public_repo".
GITHUB_TOKEN=

# ── Observability (chỉ khởi động khi chạy `docker compose --profile observability up`) ──
# Mật khẩu tài khoản "admin" của Grafana. Lưu ý: đăng nhập ẩn danh (anonymous)
# đang được cấp quyền Admin và form đăng nhập đang bị tắt (xem service grafana
# trong docker-compose.yml), nên mật khẩu này hiện KHÔNG có tác dụng chặn truy
# cập trừ khi bạn tự bật lại form đăng nhập — chỉ nên dùng observability stack
# trong mạng nội bộ/không public port 3001 ra ngoài.
GRAFANA_PASSWORD=admin
